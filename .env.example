# —— Web（apps/web）——
# NEXT_PUBLIC_API_BASE=/api
# API_INTERNAL_BASE=http://127.0.0.1:8020
# CANONICAL_HOST=

# —— API（apps/api）——
# SNS_META_DB=   # 默认 <repo>/data/app.sqlite
# SNS_CONFIG=    # 默认 <repo>/config/app.json
# SNS_COOKIE_SECURE=0
# SCRAPE_ORIGIN=http://127.0.0.1:9210
# Bitmagnet / 色花资源库 DSN 在设置页或 config/app.local.json（bitmagnet_db / resource_db）

# —— Scrape Worker（apps/scrape）——
# PORT=9210
# HOST=127.0.0.1
# FLARESOLVERR_URL=
# HTTP_PROXY=
# HTTPS_PROXY=
# THEPORNDB_API_KEY=   # ThePornDB Bearer Token（https://theporndb.net/user/api-tokens）
#
# —— FlareSolverr 智能监控 / 自动治理 ——
# FLARESOLVERR_AUTO_MANAGE=1
# FLARESOLVERR_MONITOR_INTERVAL_MS=30000
# FLARESOLVERR_MAX_SESSIONS_WARN=1
# FLARESOLVERR_MAX_SESSIONS_CRITICAL=2
# FLARESOLVERR_CPU_WARN=75
# FLARESOLVERR_CPU_CRITICAL=90
# FLARESOLVERR_MEM_WARN=70
# FLARESOLVERR_MEM_CRITICAL=85
# 同 NAS（推荐）：compose 挂 /var/run/docker.sock，用 curl 调 Docker API 重启
# FLARESOLVERR_DOCKER_NAME=flaresolverr
# FLARESOLVERR_RESTART_CMD=curl -fsS --unix-socket /var/run/docker.sock -X POST http://localhost/containers/flaresolverr/restart
# 刮削并发（默认快 2 / 慢 1，上限 4；整容器持续 <1G）
# SCRAPE_CONCURRENCY=2
# SCRAPE_FAST_CONCURRENCY=2
# SCRAPE_SLOW_CONCURRENCY=1
# SCRAPE_HOST_PARALLEL=1
# SCRAPE_MAX_HTML_BYTES=3000000
# SCRAPE_MAX_IMAGE_BYTES=5000000
# NODE_OPTIONS=--max-old-space-size=512
# 远端主机（本机 Windows 开发机 → NAS）任选其一：
# FLARESOLVERR_STATS_CMD=ssh user@192.168.2.38 "docker stats --no-stream --format '{{json .}}' flaresolverr"
# FLARESOLVERR_SSH=user@192.168.2.38
# FLARESOLVERR_RESTART_CMD=ssh user@192.168.2.38 "docker restart flaresolverr"
# FLARESOLVERR_RESTART_COOLDOWN_MS=300000
