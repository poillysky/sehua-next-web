{
  "name": "nextweb",
  "version": "0.1.0",
  "private": true,
  "description": "NextWeb monorepo: web + api + scrape",
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "cd apps/api && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8020",
    "dev:scrape": "npm run dev --prefix apps/scrape",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "start:web": "npm run start --prefix apps/web",
    "lint": "npm run lint --prefix apps/web"
  }
}
