{
  "name": "nextweb",
  "version": "1.0.20",
  "private": true,
  "description": "NextWeb monorepo: web + api (MDC-ng 外部刮削)",
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "cd apps/api && .venv\\Scripts\\python.exe dev_server.py",
    "dev:all": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "stop:all": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./stop-dev.ps1",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "start:web": "npm run start --prefix apps/web",
    "lint": "npm run lint --prefix apps/web"
  }
}
