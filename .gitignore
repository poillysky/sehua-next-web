# dependencies
node_modules/
apps/**/node_modules/

# next.js
apps/web/.next/
apps/web/out/
**/.next/
# sync-maps.mjs 生成的本地副本（源在 apps/maps）
apps/web/maps/

# python
apps/api/.venv/
**/__pycache__/
*.py[cod]

# scrape local caches
apps/scrape/data/

# testing / misc
coverage/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local
!.env.example

# local probe / scratch (never ship)
apps/api/_*.py
apps/api/_*.json
apps/api/_*.html
apps/api/_*.txt
apps/api/_*.out.txt
apps/api/_*.jpg
apps/api/_*.jpeg
apps/api/_*.png
apps/api/_*.webp
apps/api/_*.log
apps/api/_gap_reports/
apps/api/_tmp_*.py
apps/api/_tmp_*/
apps/api/_local_refs/
apps/api/__pycache__/

# mistaken / unused duplicate of repo-root data/
apps/data/

# cursor / local agent (keep out of repo)
.cursor/
.agents/
.refs/
.workbuddy/

# vercel / ts
.vercel
*.tsbuildinfo
apps/web/next-env.d.ts

# never let Next/Tailwind watch a local library mount
/library/

# DB dumps (resource / bitmagnet)
/backups/

# data (keep folder, ignore runtime DBs & heavy caches)
/data/*.sqlite
/data/*.sqlite-*
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/library/
/data/maker-fs/
/data/mirrors/
/data/prefix/
/data/cache/
/data/debug/
/data/meta/
/data/presets/
/data/*.json
# legacy flat names (pre-reorg)
/data/scrape_maps/
/data/cover-cache/
/data/_debug/
/data/prefix_catalog/
/data/scrap_facets_snap/
!/data/.gitkeep
!/data/README.md

# media (STRM / 刮削库；体积大，勿提交)
/media/scrap-library/
/media/strm-library/
/media/**
!/media/.gitkeep
!/media/README.md

# local overrides
/config/app.local.json
/config/_export/

# scratch / bench 临时产物（性能探针的本地输出）
.tmp_*
.tmp_posters/

# 拆分技能参考脚本的根目录兜底输出（正常写进 _gap_reports/）
_split_analysis.json
_verify_split_result.json
# 重构诊断产物（差分/探针脚本与报告；本机无删除权限，故只忽略不清理）
_gap_reports/

# 归档区：待人工确认后整体删除，不参与构建
_archive/
