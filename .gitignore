# dependencies
node_modules/
apps/**/node_modules/

# next.js
apps/web/.next/
apps/web/out/
**/.next/

# python
apps/api/.venv/
**/__pycache__/
*.py[cod]

# scrape local caches
apps/scrape/data/

# testing / misc
coverage/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local
!.env.example

# local probe / scratch (never ship)
apps/api/_*.py
apps/api/_*.json
apps/api/_*.html
apps/api/_*.txt
apps/api/_*.out.txt
apps/api/__pycache__/

# cursor / local agent (keep out of repo)
.cursor/
.agents/
.refs/

# vercel / ts
.vercel
*.tsbuildinfo
apps/web/next-env.d.ts

# never let Next/Tailwind watch a local library mount
/library/

# DB dumps (resource / bitmagnet)
/backups/

# data (keep folder, ignore runtime DBs & heavy caches)
/data/*.sqlite
/data/*.sqlite-*
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/library/
/data/maker-fs/
/data/scrape_maps/
/data/cover-cache/
/data/_debug/
/data/meta/
/data/prefix_catalog/
/data/presets/
/data/scrap-library/
/data/strm-library/
/data/*.json
!/data/.gitkeep
!/data/README.md

# local overrides
/config/app.local.json
/config/_export/
