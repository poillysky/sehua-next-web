# dependencies
node_modules/
apps/**/node_modules/

# next.js
apps/web/.next/
apps/web/out/
**/.next/

# python
apps/api/.venv/
**/__pycache__/
*.py[cod]

# scrape local caches
apps/scrape/data/

# testing / misc
coverage/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local
!.env.example

# local probe / scratch (never ship)
apps/api/_*.py
apps/api/_*.json
apps/api/_*.html
apps/api/__pycache__/

# cursor (keep rules optional — ignore local)
.cursor/

# vercel / ts
.vercel
*.tsbuildinfo
apps/web/next-env.d.ts

# data (keep folder, ignore runtime DBs & heavy caches)
/data/*.sqlite
/data/*.sqlite-*
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/library/
/data/maker-fs/
/data/scrape_maps/
/data/*.json
!/data/.gitkeep

# local overrides
/config/app.local.json
