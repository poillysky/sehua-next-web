# TMDB v3 API Key（影视标准英文名，一键翻译优先使用）
# 申请：https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 也可不设环境变量，登录后在 App「设置 → TMDB 翻译」里保存 Key

# —— AI / 小花（也可在 设置 → AI 模型 里配置）——
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# EMBED_PROVIDER=local
# EMBED_MODEL=intfloat/multilingual-e5-large
# EMBED_DIM=1024
# EMBED_DEVICE=cpu

# 网络搜索（小花 web_search）：Serper 或 Brave
# WEB_SEARCH_PROVIDER=serper
# WEB_SEARCH_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=
