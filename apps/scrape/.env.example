# Flare 在远程 Docker 上时：探测结束/监控临界可 docker restart
# 把 user 改成你在 192.168.2.38 上的 SSH 账号（需免密 + docker 权限）
# FLARESOLVERR_SSH=user@192.168.2.38
# FLARESOLVERR_DOCKER_NAME=flaresolverr
# FLARESOLVERR_AUTO_MANAGE=1
# 或整条命令：
# FLARESOLVERR_RESTART_CMD=ssh -o BatchMode=yes user@192.168.2.38 "docker restart flaresolverr"
